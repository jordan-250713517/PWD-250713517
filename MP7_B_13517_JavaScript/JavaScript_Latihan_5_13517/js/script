function fn_ValForm() {
    var nama = document.getElementById("nama").value;
    var email = document.getElementById("email").value;
    var umur = document.getElementById("umur").value;
    var kategori = document.getElementById("kategori").value;
    var pesan = "";

    if (nama == "") {
        pesan += "\n* Anda belum mengisikan nama";
    }

    if (email == "") {
        pesan += "\n* Anda belum mengisikan email";
    } else {
        var regexEmail = /^[a-z0-9][a-z0-9\.\-]{0,}[a-z0-9]@[a-z0-9][a-z0-9\.\-]{0,}[a-z0-9]\.[a-z0-9]{2,4}$/;
        if (!regexEmail.test(email)) {
            pesan += "\n* Format email tidak valid";
        }
    }

    if (umur == "") {
        pesan += "\n* Anda belum mengisikan umur";
    } else if (isNaN(umur) || umur < 15 || umur > 60) {
        pesan += "\n* Umur harus angka antara 15 - 60 tahun";
    }

    if (kategori == "") {
        pesan += "\n* Anda belum memilih jenis acara";
    }

    if (pesan != "") {
        alert("Peringatan:" + pesan);
        return false;
    } else {
        var info = "";
        if (umur <= 25) {
            info = "Peserta Mahasiswa";
        } else {
            info = "Peserta Umum";
        }

        var pilihan = "";
        switch (kategori) {
            case "W":
                pilihan = "Workshop";
                break;
            case "S":
                pilihan = "Seminar";
                break;
            case "L":
                pilihan = "Lomba Coding";
                break;
        }

        alert("Terima kasih " + nama + "! Anda terdaftar di acara " + pilihan + " (" + info + ").");
        return true;
    }
}